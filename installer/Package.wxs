<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Per-user install: no admin rights needed, and the adapter/server can write their logs
       next to themselves (they do; Program Files would not allow it). -->
  <Package Name="SolidPilot - MCP Server for SolidWorks"
           Manufacturer="FlightLevel"
           Version="$(ProductVersion)"
           UpgradeCode="ADD2AFE5-1619-4AA7-B3BC-B5992F76CBED"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/FlightLevel/mcp-server-solidworks" />
    <!-- Register with Claude Desktop during install. Disable with: msiexec /i SolidPilot.msi REGISTER_CLAUDE=0 -->
    <Property Id="REGISTER_CLAUDE" Value="1" Secure="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="$(StageDir)\license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SolidPilot">
          <Directory Id="AdapterParentDir" Name="adapters">
            <Directory Id="AdapterDir" Name="claude" />
          </Directory>
          <Directory Id="ServerDir" Name="server" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="SolidPilot" />
    </StandardDirectory>

    <Feature Id="Main" Title="SolidPilot" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="InstallState" />
      <ComponentRef Id="MenuShortcuts" />
    </Feature>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="$(StageDir)\app\**" />
    </ComponentGroup>

    <!-- Registry key path for the per-user folders, plus cleanup of files the app writes at runtime. -->
    <Component Id="InstallState" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\FlightLevel\SolidPilot" Name="InstallDir"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFile Id="RmAdapterLog" Directory="AdapterDir" Name="*.log" On="uninstall" />
      <RemoveFile Id="RmServerLog" Directory="ServerDir" Name="*.log" On="uninstall" />
      <RemoveFolder Id="RmAdapterDir" Directory="AdapterDir" On="uninstall" />
      <RemoveFolder Id="RmAdapterParent" Directory="AdapterParentDir" On="uninstall" />
      <RemoveFolder Id="RmServerDir" Directory="ServerDir" On="uninstall" />
      <RemoveFolder Id="RmInstallDir" On="uninstall" />
      <RemoveFolder Id="RmProgramsDir" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <Component Id="MenuShortcuts" Directory="AppMenuDir">
      <Shortcut Id="RegisterShortcut" Name="Register SolidPilot with Claude Desktop"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tools\register-claude.ps1&quot; -Pause"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="UnregisterShortcut" Name="Unregister SolidPilot from Claude Desktop"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tools\register-claude.ps1&quot; -Unregister -Pause"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="FolderShortcut" Name="SolidPilot Folder" Target="[INSTALLFOLDER]" />
      <RemoveFolder Id="RmAppMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FlightLevel\SolidPilot" Name="Shortcuts"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Claude Desktop registration (merges an mcpServers entry into claude_desktop_config.json). -->
    <SetProperty Id="RegisterClaude" Sequence="execute" Before="RegisterClaude"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tools\register-claude.ps1&quot;" />
    <CustomAction Id="RegisterClaude" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <SetProperty Id="UnregisterClaude" Sequence="execute" Before="UnregisterClaude"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tools\register-claude.ps1&quot; -Unregister" />
    <CustomAction Id="UnregisterClaude" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterClaude" After="InstallFiles"
              Condition="NOT REMOVE AND REGISTER_CLAUDE=&quot;1&quot;" />
      <Custom Action="UnregisterClaude" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
